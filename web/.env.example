# Everything works without these. Leave them empty for demo mode.

# NEAR AI Cloud key (https://cloud.near.ai, $10 free credit via https://nearbuilders.org/join).
# When set, NEAR AI rewrites facts and judges rulings, and each answer is checked against its TEE signature.
NEAR_AI_API_KEY=

# Optional: which NEAR-hosted (TEE) models to use.
# NEAR_AI_MODEL=Qwen/Qwen3.8-27B
# NEAR_AI_PANEL=Qwen/Qwen3.8-27B,z-ai/glm-5.3-flash,deepseek-ai/DeepSeek-V4.1-Flash-1017

# Optional: the NEAR account that should receive coins in 1Click quotes (dry runs only).
# VERITY_RECEIVER=intents.near
